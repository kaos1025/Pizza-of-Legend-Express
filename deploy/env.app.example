# deploy/.env.app 로 복사 후 값 채우기
# docker compose -f deploy/docker-compose.app.yml --env-file deploy/.env.app up -d --build

# ---- 도메인 (Caddy) ----
APP_DOMAIN=pizzalegend.example.com
API_DOMAIN=api.pizzalegend.example.com

# ---- Supabase (self-hosted) ----
# API_DOMAIN 과 동일한 https URL
NEXT_PUBLIC_SUPABASE_URL=https://api.pizzalegend.example.com
# supabase-docker/.env 에서 생성한 ANON_KEY / SERVICE_ROLE_KEY (JWT 형식)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Web Push ----
# 반드시 기존(호스티드 시절) VAPID 공개키 그대로 — 바꾸면 기존 구독 전부 무효
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---- Admin ----
ADMIN_PIN=
ADMIN_SESSION_SECRET=

# ---- Telegram (선택: /api/admin/settings/telegram/discover 용) ----
TELEGRAM_BOT_TOKEN=
